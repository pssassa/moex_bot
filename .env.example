# Скопируйте в .env и подставьте свой токен Hugging Face (бесплатный аккаунт).
# Токен: https://huggingface.co/settings/tokens
# Нужен fine-grained token с правом «Make calls to Inference Providers»:
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained

HF_TOKEN=
HF_MODEL=Qwen/Qwen3.8-27B
HF_PROVIDER=novita

# В Docker Compose это значение переопределяется на внутренний хост db.
DATABASE_URL=postgresql+psycopg://moex:moex@localhost:5432/moex

FORECAST_CACHE_HOURS=6
CANDLE_HISTORY_DAYS=500
NEWS_MAX_AGE_DAYS=14
